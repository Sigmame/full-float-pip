{
  "manifest_version": 3,
  "name": "VibeFloat",
  "version": "1.1.0",
  "description": "Nhạc và phim nổi trên Cursor, VS Code và Terminal khi đang code.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://phimapi.com/*",
    "https://*.phimapi.com/*",
    "https://ophim1.com/*",
    "https://*.ophim1.com/*",
    "https://phim.nguonc.com/*",
    "https://*.nguonc.com/*",
    "https://*.streamc.xyz/*",
    "https://phimimg.com/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "sub-interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "ai-dubbing.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sub-interceptor.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "float-current-video": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "MacCtrl+Shift+Y" },
      "description": "Phát nổi video đang xem trên tab hiện tại"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
