{
  "manifest_version": 3,
  "name": "VibeFloat",
  "version": "1.1.2",
  "description": "Nh\u1ea1c v\u00e0 phim n\u1ed5i tr\u00ean Cursor, VS Code v\u00e0 Terminal khi \u0111ang code.",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.phimapi.com/*",
    "https://*.ophim1.com/*",
    "https://*.nguonc.com/*",
    "https://*.streamc.xyz/*",
    "https://*.kkphimplayer.com/*",
    "https://*.kkphimplayer6.com/*",
    "https://*.kkphim.com/*",
    "https://*.ophim.com/*",
    "https://phimimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.phimapi.com/*",
        "https://*.ophim1.com/*",
        "https://*.nguonc.com/*",
        "https://*.streamc.xyz/*",
        "https://*.kkphimplayer.com/*",
        "https://*.kkphimplayer6.com/*",
        "https://*.kkphim.com/*",
        "https://*.ophim.com/*"
      ],
      "all_frames": false,
      "js": [
        "site-access.js",
        "sub-interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.phimapi.com/*",
        "https://*.ophim1.com/*",
        "https://*.nguonc.com/*",
        "https://*.streamc.xyz/*",
        "https://*.kkphimplayer.com/*",
        "https://*.kkphimplayer6.com/*",
        "https://*.kkphim.com/*",
        "https://*.ophim.com/*"
      ],
      "all_frames": false,
      "js": [
        "site-access.js",
        "ai-dubbing.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sub-interceptor.js"
      ],
      "matches": [
        "https://*.phimapi.com/*",
        "https://*.ophim1.com/*",
        "https://*.nguonc.com/*",
        "https://*.streamc.xyz/*",
        "https://*.kkphimplayer.com/*",
        "https://*.kkphimplayer6.com/*",
        "https://*.kkphim.com/*",
        "https://*.ophim.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "float-current-video": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+Y"
      },
      "description": "Ph\u00e1t n\u1ed5i video \u0111ang xem tr\u00ean tab hi\u1ec7n t\u1ea1i"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
